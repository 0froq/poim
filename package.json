{
  "name": "poim",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^24.21.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "deploy": "pnpm generate && cf deploy",
    "preview": "nuxt preview",
    "preview:deploy": "pnpm generate && cf previews deploy",
    "worker:dev": "wrangler dev --local --experimental-new-config",
    "worker:typecheck": "tsc -p worker/tsconfig.json",
    "lint": "vp lint -c vp.config.ts",
    "lint:fix": "vp lint --fix -c vp.config.ts",
    "fmt": "vp fmt -c vp.config.ts",
    "fmt:check": "vp fmt --check -c vp.config.ts",
    "typecheck": "nuxt typecheck",
    "check": "vp run lint && vp run fmt:check && vp run typecheck && vp run worker:typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "nuxt prepare",
    "prepare": "npx simple-git-hooks"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "catalog:prod",
    "@fontsource-variable/geist": "catalog:prod",
    "@fontsource-variable/geist-mono": "catalog:prod",
    "@fontsource-variable/instrument-sans": "catalog:prod",
    "@fontsource/instrument-serif": "catalog:prod",
    "@froq/ui": "file:vendor/ui",
    "@vueuse/core": "catalog:prod",
    "@vueuse/nuxt": "catalog:prod",
    "h3": "catalog:prod",
    "isomorphic-dompurify": "catalog:prod",
    "modern-screenshot": "catalog:prod",
    "nuxt": "catalog:prod",
    "vue": "catalog:prod",
    "zod": "catalog:prod"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:dev",
    "@liangmi/vp-config": "catalog:dev",
    "@types/node": "catalog:dev",
    "@unocss/nuxt": "catalog:dev",
    "@unocss/preset-attributify": "catalog:dev",
    "@unocss/preset-tagify": "catalog:dev",
    "@unocss/preset-typography": "catalog:dev",
    "@unocss/preset-wind4": "catalog:dev",
    "@unocss/transformer-directives": "catalog:dev",
    "@unocss/transformer-variant-group": "catalog:dev",
    "cf": "catalog:dev",
    "happy-dom": "catalog:dev",
    "lint-staged": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "typescript": "catalog:dev",
    "unocss": "catalog:dev",
    "vite-plus": "catalog:dev",
    "vitest": "catalog:dev",
    "vue-tsc": "catalog:dev",
    "wrangler": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx lint-staged"
  },
  "lint-staged": {
    "*": [
      "vp lint --fix --no-error-on-unmatched-pattern -c vp.config.ts",
      "vp fmt --no-error-on-unmatched-pattern -c vp.config.ts"
    ]
  }
}
